[Unit]
Description=VIGIL UAT instance (loopback only; target of Flect VAPT)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/VIGIL-uat
ExecStart=%h/VIGIL/.venv/bin/python -m vigil.main
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=VIGIL_HOST=127.0.0.1
Environment=VIGIL_PORT=8190
Environment=VIGIL_DATA_DIR=%h/VIGIL-uat-data
Environment=VIGIL_TLS_CERT=%h/VIGIL-uat-data/certs/server.crt
Environment=VIGIL_TLS_KEY=%h/VIGIL-uat-data/certs/server.key
Environment=VIGIL_COOKIE_SECURE=true
Environment=VIGIL_FRS_ENABLED=false
Environment=VIGIL_AGENTS_ENABLED=false
Environment=VIGIL_DEVICE=cpu
Environment=VIGIL_TIMEZONE=Asia/Kolkata
# Models are shared read-only with prod (gitignored, not in the clone).
Environment=VIGIL_MODELS_DIR=%h/VIGIL/models
Environment=VIGIL_VIOLENCE_MODEL_DIR=%h/VIGIL/models/violence/videomae_rwf2000
Environment=VIGIL_FACE_DET_MODEL=%h/VIGIL/models/frs/det_10g.onnx
Environment=VIGIL_FACE_REC_MODEL=%h/VIGIL/models/frs/adaface_ir101_webface12m.onnx
StandardOutput=append:%h/VIGIL-uat-data/logs/service.out
StandardError=append:%h/VIGIL-uat-data/logs/service.out
MemoryMax=4G
MemorySwapMax=0

[Install]
WantedBy=default.target
# Not enabled at boot: Flect starts UAT on demand (deploy / tests / VAPT) and stops it afterwards.
