#!/usr/sbin/nft -f
# Flect blocklist. Loaded at boot by flect-nft.service. Only the flect-nft helper modifies it.
table inet flect
delete table inet flect
table inet flect {
    set blocklist4 { type ipv4_addr; flags timeout; }
    set blocklist6 { type ipv6_addr; flags timeout; }
    set rl4 { type ipv4_addr; size 65535; flags dynamic, timeout; timeout 1m; }
    set rl6 { type ipv6_addr; size 65535; flags dynamic, timeout; timeout 1m; }

    chain flood {
        # flect-nft flood-on adds per-source new-connection rate limits here; flood-off flushes it.
    }

    chain input {
        type filter hook input priority -10; policy accept;
        iif "lo" accept
        tcp dport { 8090, 8190 } ip saddr @blocklist4 drop
        tcp dport { 8090, 8190 } ip6 saddr @blocklist6 drop
        tcp dport { 8090, 8190 } ct state new jump flood
    }
}
